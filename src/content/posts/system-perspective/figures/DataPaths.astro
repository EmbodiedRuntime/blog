---
// Managing data: the same segmentation model run as a function call vs. as a service, on a timeline.
// Function call: the caller halts until the result returns, and nothing is kept between calls.
// Service: the model runs only when needed, but the service keeps its own state between requests
// (model loaded, last masks, object IDs), and it works asynchronously while the caller keeps going.
import '../../../../components/diagram/diagram.css';
import { arrowize } from '../../../../components/diagram/graph';

type Seg = { start: number; end: number; label: string; kind: 'work' | 'wait' | 'model' | 'state' };
type Msg = { t: number; down: boolean; label: string };
type Row = { name: string; sub: string; caller: Seg[]; model: Seg[]; msgs: Msg[]; note: string };

const rows: Row[] = [
  {
    name: 'Function call',
    sub: 'caller waits',
    caller: [
      { start: 0, end: 1, label: 'plan', kind: 'work' },
      { start: 1, end: 3, label: 'waiting', kind: 'wait' },
      { start: 3, end: 4.5, label: 'grasp', kind: 'work' },
      { start: 4.5, end: 6.5, label: 'waiting', kind: 'wait' },
      { start: 6.5, end: 8, label: 'place', kind: 'work' },
    ],
    model: [
      { start: 1, end: 3, label: 'load, segment', kind: 'model' },
      { start: 4.5, end: 6.5, label: 'load, segment', kind: 'model' },
    ],
    msgs: [
      { t: 1, down: true, label: 'call' },
      { t: 3, down: false, label: 'masks' },
      { t: 4.5, down: true, label: 'call' },
      { t: 6.5, down: false, label: 'masks' },
    ],
    note: 'nothing kept between calls: is it the same cup?',
  },
  {
    name: 'Service',
    sub: 'caller keeps working',
    caller: [
      { start: 0, end: 1, label: 'plan', kind: 'work' },
      { start: 1, end: 4.5, label: 'grasp', kind: 'work' },
      { start: 4.5, end: 8, label: 'place', kind: 'work' },
    ],
    model: [
      { start: 0, end: 8, label: '', kind: 'state' },
      { start: 1, end: 2, label: 'segment', kind: 'model' },
      { start: 4.5, end: 5.5, label: 'segment', kind: 'model' },
    ],
    msgs: [
      { t: 1, down: true, label: 'query' },
      { t: 2, down: false, label: 'cup #3' },
      { t: 4.5, down: true, label: 'query' },
      { t: 5.5, down: false, label: 'still cup #3' },
    ],
    note: 'runs when asked, keeps its state, answers asynchronously',
  },
];

const T = 8;
const x0 = 170;
const unit = 62;
const laneH = 28;
const gap = 34;
const rowGap = 54;
const top = 24;
const rowH = 2 * laneH + gap;
const W = x0 + T * unit + 20;
const H = top + rows.length * rowH + (rows.length - 1) * rowGap + 40;
const rowY = (i: number) => top + i * (rowH + rowGap);
const X = (t: number) => x0 + t * unit;
---

<div class="dg-scroll">
  <svg class="dg dp" viewBox={`10 0 ${W - 28} ${H}`} style="min-width:600px" role="img" aria-label="Timelines. As a function call, the program waits while the model loads and segments one frame, twice, and nothing is kept between calls. As a service, segmentation runs only when queried but keeps the model, masks, and object IDs between requests, and the program keeps working while the service answers.">
    <defs>
      <pattern id="dp-hatch" width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
        <line x1="0" y1="0" x2="0" y2="6" class="hatch" />
      </pattern>
    </defs>

    {
      rows.map((row, i) => {
        const yCaller = rowY(i);
        const yModel = rowY(i) + laneH + gap;
        return (
          <g>
            <text class="dg-title" x="12" y={yCaller + rowH / 2 - 2}>{row.name}</text>
            <text class="dg-note" x="12" y={yCaller + rowH / 2 + 15}>{row.sub}</text>
            <text class="dg-note lane" x={x0 - 10} y={yCaller + laneH / 2 + 4} text-anchor="end">Program</text>
            <text class="dg-note lane" x={x0 - 10} y={yModel + laneH / 2 + 4} text-anchor="end">Segmentation</text>
            {[...row.caller.map((s) => ({ s, y: yCaller })), ...row.model.map((s) => ({ s, y: yModel }))].map(({ s, y }) => (
              <g class={`seg seg-${s.kind}`}>
                <rect x={X(s.start) + 1} y={y} width={(s.end - s.start) * unit - 2} height={laneH} rx="5" />
                {s.label && <text x={X((s.start + s.end) / 2)} y={y + laneH / 2 + 4} text-anchor="middle">{s.label}</text>}
              </g>
            ))}
            {row.model.some((s) => s.kind === 'state') && (
              <>
                <text class="state-label" x={X(3.25)} y={yModel + laneH / 2 + 4} text-anchor="middle">keeps masks, cup IDs</text>
                <text class="state-label" x={X(6.75)} y={yModel + laneH / 2 + 4} text-anchor="middle">idle, state kept</text>
              </>
            )}
            {row.msgs.map((m) => {
              const a = arrowize(m.down ? `M${X(m.t)},${yCaller + laneH + 2} L${X(m.t)},${yModel - 2}` : `M${X(m.t)},${yModel - 2} L${X(m.t)},${yCaller + laneH + 2}`, 7, 3.5);
              return (
                <g class="msg">
                  <path d={a.d} />
                  <path class="head" d={a.head} />
                  <text x={m.down ? X(m.t) - 5 : X(m.t) + 5} y={yCaller + laneH + gap / 2 + 4} text-anchor={m.down ? 'end' : 'start'}>{m.label}</text>
                </g>
              );
            })}
            <text class="dg-note" x={X(T)} y={yModel + laneH + 18} text-anchor="end">{row.note}</text>
          </g>
        );
      })
    }
  </svg>
</div>

<style>
  .seg rect {
    stroke: none;
  }
  .seg text {
    font-size: 11.5px;
    font-weight: 600;
  }
  .seg-work rect {
    fill: color-mix(in srgb, var(--dg-ok) 32%, var(--bg));
  }
  .seg-wait rect {
    fill: url(#dp-hatch);
    stroke: var(--border);
  }
  .seg-wait text {
    fill: var(--muted);
    font-weight: 400;
  }
  .seg-model rect {
    fill: color-mix(in srgb, var(--accent) 34%, var(--bg));
  }
  .seg-state rect {
    fill: var(--bg);
    stroke: var(--accent);
    stroke-width: 1.5;
    stroke-dasharray: 5 4;
  }
  .state-label {
    font-size: 11px;
    fill: var(--accent) !important;
  }
  .hatch {
    stroke: var(--border);
    stroke-width: 2;
  }
  .msg path {
    fill: none;
    stroke: var(--fg);
    stroke-width: 1.4;
  }
  .msg .head {
    fill: var(--fg);
    stroke: none;
  }
  .msg text {
    font-size: 11px;
    fill: var(--muted);
  }
  .lane {
    font-weight: 600;
  }
</style>
