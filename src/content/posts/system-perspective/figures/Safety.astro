---
// Safety: a model or a program emits a command that would cause irreversible damage.
// Three requirements: identify the problem, have authority to stop or change the program,
// and have a fallback to execute.
import Graph from '../../../../components/diagram/Graph.astro';
import Stepper from '../../../../components/diagram/Stepper.astro';
import type { GEdge, GNode } from '../../../../components/diagram/graph';

const nodes: GNode[] = [
  { id: 'vlm', x: 100, y: 56, w: 150, label: 'VLM agent', kind: 'model' },
  { id: 'program', x: 100, y: 200, w: 150, label: 'Program / skill', kind: 'program' },
  { id: 'guard', x: 380, y: 128, w: 170, h: 64, label: 'Safety layer', sub: 'checks every command', kind: 'runtime' },
  { id: 'arm', x: 640, y: 128, w: 130, label: 'Arm', kind: 'io' },
  { id: 'fallback', x: 380, y: 262, w: 170, label: 'Fallback', sub: 'stop · hold · retract', kind: 'runtime', step: 3 },
];

const edges: GEdge[] = [
  { from: 'vlm', to: 'program', label: 'plan' },
  { from: 'program', to: 'guard', label: 'command', until: 1 },
  { from: 'program', to: 'guard', label: 'move through table', tone: 'fail', step: 1 },
  { from: 'guard', to: 'arm', label: 'allowed', until: 2 },
  { from: 'guard', to: 'arm', label: 'blocked', tone: 'fail', dashed: true, step: 2 },
  { from: 'guard', to: 'program', bend: -40, label: 'preempt', tone: 'accent', step: 2 },
  { from: 'guard', to: 'fallback', step: 3 },
  { from: 'fallback', to: 'arm', label: 'safe stop', tone: 'accent', step: 3 },
  { from: 'guard', to: 'vlm', d: 'M330,94 C300,60 240,52 179,54', labelAt: { x: 262, y: 48 }, label: 'rejected: collision', tone: 'accent', dashed: true, step: 4 },
];

type Badge = { x: number; y: number; text: string; tone: 'fail' | 'warn' | 'ok'; step?: number; until?: number };
const badges: Badge[] = [
  { x: 100, y: 172, text: 'unsafe output', tone: 'fail', step: 1 },
  { x: 640, y: 100, text: 'safe state', tone: 'ok', step: 3 },
];
// The three requirements, lit up as each one comes into play.
const reqs = [
  { n: 1, text: 'Identify the problem', step: 2 },
  { n: 2, text: 'Authority to intervene', step: 2 },
  { n: 3, text: 'A fallback to execute', step: 3 },
];
const bw = (t: string) => t.length * 7 + 16;

const steps = [
  'Normal operation: every command passes through a safety layer before it reaches the arm.',
  'A weak model or a buggy program emits a command that would drive the arm through the table.',
  'Identify and take authority: the safety layer recognizes the violation, blocks the command, and preempts the program.',
  'Fallback: a behavior verified in advance brings the robot to a safe state.',
  'The rejection and its reason go back to the agent, which can replan. The damage never happened.',
];
---

<Stepper steps={steps} interval={3000}>
  <Graph nodes={nodes} edges={edges} x0={20} width={700} height={300} minWidth={600} label="A safety layer between programs and the arm identifies an unsafe command, blocks it and preempts the program, runs a fallback to a safe state, and reports the rejection to the agent.">
    {
      badges.map((b) => (
        <g class={`dg-badge dg-badge-${b.tone}`} data-step={b.step} data-until={b.until}>
          <rect x={b.x - bw(b.text) / 2} y={b.y - 10} width={bw(b.text)} height="20" rx="10" />
          <text x={b.x} y={b.y + 4} text-anchor="middle">{b.text}</text>
        </g>
      ))
    }
    <text class="dg-title" x="560" y="214">Safety requires</text>
    {
      reqs.map((r, i) => (
        <g class="req" transform={`translate(560, ${236 + i * 22})`}>
          <g class="req-off" data-until={r.step}>
            <circle cx="8" cy="-4" r="8" />
            <text x="22" y="0">{r.text}</text>
          </g>
          <g class="req-on" data-step={r.step}>
            <circle cx="8" cy="-4" r="8" />
            <text class="req-n" x="8" y="0" text-anchor="middle">{r.n}</text>
            <text x="22" y="0">{r.text}</text>
          </g>
        </g>
      ))
    }
  </Graph>
</Stepper>

<style>
  .req text {
    font-size: 12px;
  }
  .req-off circle {
    fill: none;
    stroke: var(--border);
  }
  .req-off text {
    fill: var(--muted);
  }
  .req-on circle {
    fill: var(--accent);
  }
  .req-on text {
    font-weight: 600;
  }
  .req-on .req-n {
    fill: var(--accent-fg);
    font-size: 10.5px;
  }
</style>
